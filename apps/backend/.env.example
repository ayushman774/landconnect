NODE_ENV=development
PORT=4000
# PostgreSQL connection string. Do not commit real credentials.
DATABASE_URL=postgresql://landconnect:change-me@localhost:5432/landconnect?schema=public
# Explicit comma-separated origins; localhost is for local development only.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Generate a unique secret with at least 32 bytes for each environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
